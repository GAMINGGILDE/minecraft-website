---
export interface Props {
  title: string;
  subtitle?: string;
  class?: string;
  subtitleClass?: string;
  headerClass?: string;
  actionsClass?: string;
  actionsInline?: boolean;
}

const {
  title,
  subtitle,
  class: className = '',
  subtitleClass = 'text-muted mt-2',
  headerClass = '',
  actionsClass = 'mt-6 flex flex-wrap gap-3',
  actionsInline = false,
} = Astro.props as Props;

const hasActions = Astro.slots.has('actions');
const hasBeforeActions = Astro.slots.has('beforeActions');
const hasContent = Astro.slots.has('default');
const hasSubtitle = Astro.slots.has('subtitle');
---

<section class={`mg-container pt-12 pb-6 ${className}`.trim()}>
  {actionsInline ? (
    <>
      <div class={headerClass}>
        <div>
          <h1 class="text-3xl font-semibold tracking-tight" data-motion="reveal">
            {title}
          </h1>
          {hasSubtitle ? (
            <p class={subtitleClass} data-motion="reveal" data-motion-delay="70">
              <slot name="subtitle" />
            </p>
          ) : (
            subtitle && (
              <p class={subtitleClass} data-motion="reveal" data-motion-delay="70">
                {subtitle}
              </p>
            )
          )}
        </div>
        {hasActions && (
          <div class={actionsClass} data-motion="reveal" data-motion-delay="120">
            <slot name="actions" />
          </div>
        )}
      </div>
      {hasBeforeActions && (
        <div data-motion="reveal" data-motion-delay="160">
          <slot name="beforeActions" />
        </div>
      )}
      {hasContent && (
        <div data-motion="reveal" data-motion-delay="200">
          <slot />
        </div>
      )}
    </>
  ) : (
    <>
      <div class={headerClass}>
        <h1 class="text-3xl font-semibold tracking-tight" data-motion="reveal">
          {title}
        </h1>
        {hasSubtitle ? (
          <p class={subtitleClass} data-motion="reveal" data-motion-delay="70">
            <slot name="subtitle" />
          </p>
        ) : (
          subtitle && (
            <p class={subtitleClass} data-motion="reveal" data-motion-delay="70">
              {subtitle}
            </p>
          )
        )}
      </div>
      {hasBeforeActions && (
        <div data-motion="reveal" data-motion-delay="160">
          <slot name="beforeActions" />
        </div>
      )}
      {hasActions && (
        <div class={actionsClass} data-motion="reveal" data-motion-delay="120">
          <slot name="actions" />
        </div>
      )}
      {hasContent && (
        <div data-motion="reveal" data-motion-delay="200">
          <slot />
        </div>
      )}
    </>
  )}
</section>
