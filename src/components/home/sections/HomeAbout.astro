---
import Button from '../../ui/Button.astro';
import IconButton from '../../ui/IconButton.astro';
import HomePanel from '../HomePanel.astro';
import HomeSection from '../HomeSection.astro';

import type { GalleryImage } from '../../../lib/home/gallery';
import { Book, ChevronLeft, ChevronRight, ScrollText } from '@lucide/astro';
import { minecraftGilde } from '../../../config/minecraftGilde';

export interface Props {
  galleryImages: GalleryImage[];
}

const { galleryImages } = Astro.props as Props;
const galleryInitialImage = galleryImages[0];

const ORGANIZATION_NAME = minecraftGilde.organization.name;
---

<HomeSection id="about" size="normal">
  <div class="grid items-center gap-16 lg:grid-cols-2 lg:gap-20">
    <div>
      <h2 class="text-3xl font-semibold tracking-tight" data-motion="reveal">
        Was ist die Minecraft Gilde?
      </h2>
      <div
        class="mg-prose text-muted mt-5 max-w-2xl text-base"
        data-motion="reveal"
        data-motion-delay="80"
      >
        <p>
          Die Minecraft Gilde ist ein deutschsprachiger Minecraft-Java-Server für Vanilla-SMP,
          Survival und Freebuild und ist der Minecraft-Server der {ORGANIZATION_NAME}. Auf unserer
          dauerhaften Hauptwelt kannst du langfristig bauen, entdecken und deine Projekte wachsen
          lassen – ohne Weltresets, ohne Pay2Win und ohne den Fokus auf Minigames oder Citybuild.
          Unsere heutige Hauptwelt besteht seit Februar 2024.
        </p>
        <p>
          Du suchst dir per <code>/rtp</code> einen Platz, schützt dein eigenes Gebiet mit Claims und
          holst Ressourcen in separaten Farmwelten. Danach kannst du einfach losbauen, entdecken und deine
          Projekte langfristig weiterentwickeln.
        </p>
      </div>
      <div class="mt-8 flex flex-wrap gap-3" data-motion="reveal" data-motion-delay="140">
        <Button href="/serverinfos" variant="secondary" class="gap-2">
          <ScrollText size={18} /> Serverinfos
        </Button>
        <Button href="/regeln" variant="ghost" class="gap-2">
          <Book size={18} /> Regeln
        </Button>
      </div>
    </div>

    <div
      class="relative"
      data-motion="reveal"
      data-motion-direction="right"
      data-motion-delay="120"
    >
      <HomePanel
        variant="outline"
        class="overflow-hidden"
        data-gallery
        data-gallery-interval="5200"
        data-gallery-preload-delay-default="350"
        data-gallery-preload-delay-slow="1200"
        data-gallery-images={JSON.stringify(galleryImages)}
      >
        <div class="group relative h-[340px] w-full sm:h-[380px]">
          <div
            data-gallery-placeholder
            class="mg-mesh-bg absolute inset-0 opacity-100 transition-opacity duration-[450ms]"
          >
          </div>

          <img
            data-gallery-a
            {...galleryInitialImage}
            alt="Impressionen vom Server - Minecraft Gilde"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover opacity-100 transition-opacity duration-700"
          />

          <noscript>
            <img
              {...galleryInitialImage}
              alt="Impressionen vom Server - Minecraft Gilde"
              class="absolute inset-0 h-full w-full object-cover opacity-100"
            />
          </noscript>

          <img
            data-gallery-b
            {...galleryInitialImage}
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700"
          />

          <div class="absolute inset-y-0 left-0 flex items-center pl-3">
            <IconButton
              data-gallery-prev
              ariaLabel="Vorheriges Bild"
              variant="secondary"
              class="h-9 min-h-9 w-9 min-w-9 rounded-full backdrop-blur transition lg:pointer-events-none lg:opacity-0 lg:group-focus-within:pointer-events-auto lg:group-focus-within:opacity-100 lg:group-hover:pointer-events-auto lg:group-hover:opacity-100"
            >
              <ChevronLeft size={20} aria-hidden="true" />
            </IconButton>
          </div>

          <div class="absolute inset-y-0 right-0 flex items-center pr-3">
            <IconButton
              data-gallery-next
              ariaLabel="Naechstes Bild"
              variant="secondary"
              class="h-9 min-h-9 w-9 min-w-9 rounded-full backdrop-blur transition lg:pointer-events-none lg:opacity-0 lg:group-focus-within:pointer-events-auto lg:group-focus-within:opacity-100 lg:group-hover:pointer-events-auto lg:group-hover:opacity-100"
            >
              <ChevronRight size={20} aria-hidden="true" />
            </IconButton>
          </div>
        </div>
      </HomePanel>
    </div>
  </div>
</HomeSection>
