---
import HomeSection from '../HomeSection.astro';
import { minecraftGilde } from '../../../config/minecraftGilde';
import {
  ArrowRight,
  BadgeCheck,
  Book,
  ChartColumn,
  CircleQuestionMark,
  Handshake,
  Map,
  Server,
  SquareTerminal,
  Users,
} from '@lucide/astro';

const DYNMAP_URL = minecraftGilde.mapUrl;
const ORGANIZATION_NAME = minecraftGilde.organization.name;
const ORGANIZATION_URL = minecraftGilde.organization.url;
---

<HomeSection id="links" size="normal">
  <div data-motion="reveal">
    <h2 class="text-2xl font-semibold tracking-tight">Mehr entdecken</h2>
    <p class="text-muted mt-3 max-w-2xl text-sm">
      Wenn du tiefer einsteigen willst, findest du hier die wichtigsten Seiten auf einen Blick.
    </p>
  </div>

  <div class="mt-8 grid gap-4 lg:grid-cols-12">
    <article
      class="mg-card mg-card--soft mg-card--hover relative overflow-hidden p-5 sm:p-6 lg:col-span-5"
      data-motion="reveal"
      data-motion-delay="80"
    >
      <h3 class="text-base font-semibold">Start & Orientierung</h3>
      <p class="text-muted mt-2 text-sm">
        Alles für den schnellen Einstieg: Serverdaten, Karte und deine ersten Statistiken.
      </p>

      <ul class="mg-list divide-border/75 mt-4 divide-y">
        <li>
          <a
            href="/serverinfos/"
            class="focus-visible:ring-offset-bg group hover:bg-surface/35 flex items-start justify-between gap-3 rounded-md px-1 py-3 transition-colors focus-visible:ring-2 focus-visible:ring-[color:var(--ring)] focus-visible:outline-none"
          >
            <span class="flex items-start gap-3">
              <span class="bg-accent/15 border-accent/25 text-accent mt-0.5 inline-flex size-8 shrink-0 items-center justify-center rounded-lg border">
                <Server size={15} />
              </span>
              <span>
                <span class="block text-sm font-semibold">Serverinfos</span>
                <span class="text-muted block text-xs">
                  Version, Technik und wichtige Hinweise.
                </span>
              </span>
            </span>
            <ArrowRight class="text-muted group-hover:text-fg mt-0.5 h-4 w-4 shrink-0 transition-colors" />
          </a>
        </li>

        <li>
          <a
            href={DYNMAP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="focus-visible:ring-offset-bg group hover:bg-surface/35 flex items-start justify-between gap-3 rounded-md px-1 py-3 transition-colors focus-visible:ring-2 focus-visible:ring-[color:var(--ring)] focus-visible:outline-none"
          >
            <span class="flex items-start gap-3">
              <span class="bg-accent/15 border-accent/25 text-accent mt-0.5 inline-flex size-8 shrink-0 items-center justify-center rounded-lg border">
                <Map size={15} />
              </span>
              <span>
                <span class="block text-sm font-semibold">Karte</span>
                <span class="text-muted block text-xs">
                  Live auf die Welt schauen und Orte finden.
                </span>
              </span>
            </span>
            <ArrowRight class="text-muted group-hover:text-fg mt-0.5 h-4 w-4 shrink-0 transition-colors" />
          </a>
        </li>

        <li>
          <a
            href="/statistiken/"
            class="focus-visible:ring-offset-bg group hover:bg-surface/35 flex items-start justify-between gap-3 rounded-md px-1 py-3 transition-colors focus-visible:ring-2 focus-visible:ring-[color:var(--ring)] focus-visible:outline-none"
          >
            <span class="flex items-start gap-3">
              <span class="bg-accent/15 border-accent/25 text-accent mt-0.5 inline-flex size-8 shrink-0 items-center justify-center rounded-lg border">
                <ChartColumn size={15} />
              </span>
              <span>
                <span class="block text-sm font-semibold">Statistiken</span>
                <span class="text-muted block text-xs">
                  Rankings, Metriken und Spielerwerte im Blick.
                </span>
              </span>
            </span>
            <ArrowRight class="text-muted group-hover:text-fg mt-0.5 h-4 w-4 shrink-0 transition-colors" />
          </a>
        </li>
      </ul>
    </article>

    <div class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
      <article
        class="mg-card mg-card--soft mg-card--hover p-5"
        data-motion="reveal"
        data-motion-delay="120"
      >
        <h3 class="text-base font-semibold">Wissen & Regeln</h3>
        <p class="text-muted mt-2 text-sm">
          Du möchtest wissen, ob es Weltresets gibt, welche Mods erlaubt sind oder wie Claims
          funktionieren? In den FAQ findest du die wichtigsten Antworten.
        </p>

        <ul class="mg-list divide-border/75 mt-4 divide-y">
          <li>
            <a
              href="/regeln/"
              class="focus-visible:ring-offset-bg group hover:bg-surface/35 flex items-center justify-between gap-3 rounded-md px-1 py-3 transition-colors focus-visible:ring-2 focus-visible:ring-[color:var(--ring)] focus-visible:outline-none"
            >
              <span class="inline-flex items-center gap-2 text-sm font-medium">
                <Book size={15} /> Regeln
              </span>
              <ArrowRight class="text-muted group-hover:text-fg h-4 w-4 shrink-0 transition-colors" />
            </a>
          </li>
          <li>
            <a
              href="/befehle/"
              class="focus-visible:ring-offset-bg group hover:bg-surface/35 flex items-center justify-between gap-3 rounded-md px-1 py-3 transition-colors focus-visible:ring-2 focus-visible:ring-[color:var(--ring)] focus-visible:outline-none"
            >
              <span class="inline-flex items-center gap-2 text-sm font-medium">
                <SquareTerminal size={15} /> Befehle
              </span>
              <ArrowRight class="text-muted group-hover:text-fg h-4 w-4 shrink-0 transition-colors" />
            </a>
          </li>
          <li>
            <a
              href="/faq/"
              class="focus-visible:ring-offset-bg group hover:bg-surface/35 flex items-center justify-between gap-3 rounded-md px-1 py-3 transition-colors focus-visible:ring-2 focus-visible:ring-[color:var(--ring)] focus-visible:outline-none"
            >
              <span class="inline-flex items-center gap-2 text-sm font-medium">
                <CircleQuestionMark size={15} /> FAQ
              </span>
              <ArrowRight class="text-muted group-hover:text-fg h-4 w-4 shrink-0 transition-colors" />
            </a>
          </li>
        </ul>
      </article>

      <article
        class="mg-card mg-card--soft mg-card--hover p-5"
        data-motion="reveal"
        data-motion-delay="160"
      >
        <h3 class="text-base font-semibold">Community</h3>
        <p class="text-muted mt-2 text-sm">Team, Votes und Gilde-Organisation auf einen Blick.</p>

        <ul class="mg-list divide-border/75 mt-4 divide-y">
          <li>
            <a
              href="/voten/"
              class="focus-visible:ring-offset-bg group hover:bg-surface/35 flex items-center justify-between gap-3 rounded-md px-1 py-3 transition-colors focus-visible:ring-2 focus-visible:ring-[color:var(--ring)] focus-visible:outline-none"
            >
              <span class="inline-flex items-center gap-2 text-sm font-medium">
                <BadgeCheck size={15} /> Voten
              </span>
              <ArrowRight class="text-muted group-hover:text-fg h-4 w-4 shrink-0 transition-colors" />
            </a>
          </li>
          <li>
            <a
              href="/team/"
              class="focus-visible:ring-offset-bg group hover:bg-surface/35 flex items-center justify-between gap-3 rounded-md px-1 py-3 transition-colors focus-visible:ring-2 focus-visible:ring-[color:var(--ring)] focus-visible:outline-none"
            >
              <span class="inline-flex items-center gap-2 text-sm font-medium">
                <Users size={15} /> Team
              </span>
              <ArrowRight class="text-muted group-hover:text-fg h-4 w-4 shrink-0 transition-colors" />
            </a>
          </li>
          <li>
            <a
              href={ORGANIZATION_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="focus-visible:ring-offset-bg group hover:bg-surface/35 flex items-center justify-between gap-3 rounded-md px-1 py-3 transition-colors focus-visible:ring-2 focus-visible:ring-[color:var(--ring)] focus-visible:outline-none"
            >
              <span class="inline-flex items-center gap-2 text-sm font-medium">
                <Handshake size={15} />
                {ORGANIZATION_NAME}
                <span class="sr-only"> (extern)</span>
              </span>
              <ArrowRight class="text-muted group-hover:text-fg h-4 w-4 shrink-0 transition-colors" />
            </a>
          </li>
        </ul>
      </article>
    </div>
  </div>
</HomeSection>
