---
import Button from '../../ui/Button.astro';
import HomeSection from '../HomeSection.astro';
import { minecraftGilde } from '../../../config/minecraftGilde';
import LiveState from '../../live/LiveState.astro';
import { Lightbulb, Map, Users } from '@lucide/astro';

const DYNMAP_URL = minecraftGilde.mapUrl;
const STATUS_URL = minecraftGilde.statusUrl;
---

<HomeSection id="live" size="normal" tone="muted">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" data-motion="reveal">
    <div>
      <h2 class="text-3xl font-semibold tracking-tight">Live auf dem Server</h2>
      <p class="text-muted mt-3 max-w-2xl">
        Schau nach, wer gerade online ist und wie lange unsere Hauptwelt schon läuft.
      </p>
    </div>
  </div>

  <div class="mt-10">
    <article
      class="home-live-shell px-5 py-5 sm:px-6 sm:py-6 lg:px-8 lg:py-8"
      data-motion="reveal"
      data-motion-delay="100"
    >
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(19rem,0.85fr)] lg:gap-10">
        <section class="min-w-0">
          <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="text-muted text-[0.68rem] font-semibold tracking-[0.18em] uppercase">
                Jetzt online
              </p>
              <h3 class="mt-3 text-xl font-semibold tracking-tight sm:text-2xl">
                Wer ist gerade online?
              </h3>
            </div>
            <div class="home-live-player-meta">
              <span class="home-live-player-count" data-mc-online>
                0
              </span>
              <span class="home-live-player-label">Spieler</span>
            </div>
          </div>

          <div class="home-live-player-stage mt-6">
            <div class="mg-scrollbar min-h-14" id="player-list">
              <p class="text-muted text-sm">Lade Spieler...</p>
            </div>
          </div>

          <div class="text-muted mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs">
            <span class="inline-flex items-center gap-2">
              <span
                class="home-live-ping mg-status-dot"
                aria-hidden="true"
                data-live-indicator="mc-online"
                data-status-state="loading"
              ></span>
              Live-Daten
            </span>
            <span class="inline-flex items-center gap-2">
              <Lightbulb size={14} aria-hidden="true" />
              Klicke auf einen Namen, um die Spielerstatistik zu öffnen.
            </span>
          </div>
        </section>

        <aside class="home-live-rail">
          <div>
            <p class="text-muted text-[0.68rem] font-semibold tracking-[0.18em] uppercase">
              Serverpulse
            </p>
            <h3 class="mt-3 text-xl font-semibold tracking-tight">Status & Welt</h3>
          </div>

          <section class="mt-5">
            <div class="home-live-status-row" data-live-tile="mc-online" data-live-state="loading">
              <div class="flex min-w-0 items-start gap-3">
                <span class="home-live-status-icon" aria-hidden="true">
                  <Users size={16} />
                </span>
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="text-sm font-semibold">Minecraft</span>
                    <span class="home-live-badge">Live</span>
                  </div>
                  <LiveState tileKey="mc-online" statusUrl={STATUS_URL} class="mt-2" />
                </div>
              </div>
              <span class="home-live-status-value" data-mc-online>
                0
              </span>
            </div>

            <div
              class="home-live-status-row"
              data-live-tile="discord-online"
              data-live-state="loading"
            >
              <div class="flex min-w-0 items-start gap-3">
                <span class="home-live-status-icon" aria-hidden="true">
                  <Users size={16} />
                </span>
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="text-sm font-semibold">Discord</span>
                    <span class="home-live-badge">Community</span>
                  </div>
                  <LiveState tileKey="discord-online" statusUrl={STATUS_URL} class="mt-2" />
                </div>
              </div>
              <span class="home-live-status-value" data-discord-online>
                0
              </span>
            </div>
          </section>

          <section class="border-border/70 mt-6 border-t pt-6">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="text-muted text-[0.68rem] font-semibold tracking-[0.18em] uppercase">
                  Hauptwelt
                </p>
                <p class="mt-2 text-base font-semibold">Aktiv seit Februar 2024</p>
                <p class="text-muted mt-2 text-sm">
                  Laufzeit:{' '}
                  <span class="text-fg font-semibold" id="world-age">
                    -
                  </span>
                </p>
              </div>
              <Button
                href={DYNMAP_URL}
                external
                variant="secondary"
                size="sm"
                class="w-full justify-center gap-2 sm:w-auto"
              >
                <Map size={16} /> Live-Karte öffnen
              </Button>
            </div>
          </section>
        </aside>
      </div>
    </article>
  </div>
</HomeSection>
