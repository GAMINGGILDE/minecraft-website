---
import HomeSection from '../HomeSection.astro';
import { Scale, Sparkles, Wand } from '@lucide/astro';
---

<HomeSection size="tight" containerClass="py-16 sm:py-20">
  <div class="grid gap-12 md:grid-cols-3">
    <div class="flex items-start gap-4" data-motion="reveal">
      <div class="bg-accent/15 border-accent/25 mt-0.5 inline-flex size-10 shrink-0 items-center justify-center rounded-xl border">
        <Sparkles size={18} />
      </div>
      <div>
        <h2 class="text-base font-semibold">Langzeitwelt</h2>
        <p class="text-muted mt-1 text-sm">
          Ohne Weltresets – deine Projekte bleiben erhalten und dürfen über lange Zeit wachsen.
        </p>
      </div>
    </div>

    <div class="flex items-start gap-4" data-motion="reveal" data-motion-delay="80">
      <div class="bg-accent/15 border-accent/25 mt-0.5 inline-flex size-10 shrink-0 items-center justify-center rounded-xl border">
        <Scale size={18} />
      </div>
      <div>
        <h2 class="text-base font-semibold">Kein Pay-to-Win</h2>
        <p class="text-muted mt-1 text-sm">
          Keine kaufbaren Gameplay-Vorteile – bei uns gelten für alle dieselben Bedingungen.
        </p>
      </div>
    </div>

    <div class="flex items-start gap-4" data-motion="reveal" data-motion-delay="160">
      <div class="bg-accent/15 border-accent/25 mt-0.5 inline-flex size-10 shrink-0 items-center justify-center rounded-xl border">
        <Wand size={18} />
      </div>
      <div>
        <h2 class="text-base font-semibold">Vanilla+</h2>
        <p class="text-muted mt-1 text-sm">
          Praktische Komfort- und Schutzfunktionen ergänzen dein Survival-Erlebnis, ohne
          grundlegende Minecraft-Mechaniken zu ersetzen.
        </p>
      </div>
    </div>
  </div>
</HomeSection>
