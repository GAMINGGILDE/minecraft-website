---
import Button from '../../ui/Button.astro';
import HomeSection from '../HomeSection.astro';
import { minecraftGilde } from '../../../config/minecraftGilde';
import { ArrowRight, Cpu, House, Map, Shield, Sparkles, Wand } from '@lucide/astro';

const SERVER_SOFTWARE = minecraftGilde.server.software;
---

<HomeSection id="vanilla" size="normal" tone="muted">
  <div class="relative">
    <div
      class="bg-accent/6 pointer-events-none absolute -inset-x-4 -top-8 -bottom-8 -z-10 rounded-[calc(var(--radius)+22px)] blur-2xl"
      aria-hidden="true"
    ></div>

    <div
      class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
      data-motion="reveal"
    >
      <div>
        <h2 class="text-3xl font-semibold tracking-tight">Mehr Komfort, weiterhin Vanilla</h2>
        <p class="text-muted mt-3 max-w-2xl">
          Vanilla+ ergänzt dein Survival-Erlebnis um praktische Komfort- und Schutzfunktionen, ohne
          daraus Citybuild oder einen stark veränderten Spielmodus zu machen.
        </p>
      </div>
      <Button href="/tutorial" variant="secondary" class="gap-2">
        Tutorial ansehen <ArrowRight size={18} />
      </Button>
    </div>

    <div class="mt-10" data-motion="reveal" data-motion-delay="100">
      <div class="grid gap-7 md:grid-cols-2">
        <div class="flex gap-4">
          <div class="bg-accent/15 border-accent/25 inline-flex size-11 shrink-0 items-center justify-center rounded-xl border">
            <Shield size={18} />
          </div>
          <div>
            <h3 class="text-base font-semibold">Claims / Grundstücksschutz</h3>
            <p class="text-muted mt-1 text-sm">
              Mit Claims schützt du dein eigenes Gebiet, damit deine Bauprojekte sicher bleiben.
            </p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="bg-accent/15 border-accent/25 inline-flex size-11 shrink-0 items-center justify-center rounded-xl border">
            <Map size={18} />
          </div>
          <div>
            <h3 class="text-base font-semibold">Farmwelten</h3>
            <p class="text-muted mt-1 text-sm">
              Hol dir Ressourcen aus separaten Farmwelten und halte die Hauptwelt frei für deine
              Builds.
            </p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="bg-accent/15 border-accent/25 inline-flex size-11 shrink-0 items-center justify-center rounded-xl border">
            <House size={18} />
          </div>
          <div>
            <h3 class="text-base font-semibold">25 Homes für alle</h3>
            <p class="text-muted mt-1 text-sm">
              Du kannst 25 Homes setzen, kommst schnell zu deinen Projekten zurück und bleibst auch
              bei mehreren Bauorten flexibel.
            </p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="bg-accent/15 border-accent/25 inline-flex size-11 shrink-0 items-center justify-center rounded-xl border">
            <Wand size={18} />
          </div>
          <div>
            <h3 class="text-base font-semibold">/rtp</h3>
            <p class="text-muted mt-1 text-sm">
              Mit <code>/rtp</code> teleportierst du dich zufällig in die Wildnis und findest einen
              Platz für dein nächstes Projekt.
            </p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="bg-accent/15 border-accent/25 inline-flex size-11 shrink-0 items-center justify-center rounded-xl border">
            <Sparkles size={18} />
          </div>
          <div>
            <h3 class="text-base font-semibold">Vanilla-nahe Spielweise</h3>
            <p class="text-muted mt-1 text-sm">
              Homes, <code>/rtp</code> und Claims ergänzen dein Survival-Spiel, ohne grundlegende
              Minecraft-Mechaniken zu ersetzen.
            </p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="bg-accent/15 border-accent/25 inline-flex size-11 shrink-0 items-center justify-center rounded-xl border">
            <Cpu size={18} />
          </div>
          <div>
            <h3 class="text-base font-semibold">Technik mit {SERVER_SOFTWARE}</h3>
            <p class="text-muted mt-1 text-sm">
              Im Hintergrund läuft der Server auf {SERVER_SOFTWARE}. Das technische Setup erklären
              wir dir ausführlicher in unseren Serverinfos.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</HomeSection>
