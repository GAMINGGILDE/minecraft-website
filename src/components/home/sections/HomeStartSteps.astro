---
import Button from '../../ui/Button.astro';
import HomeSection from '../HomeSection.astro';
import { minecraftGilde } from '../../../config/minecraftGilde';
import { ArrowRight, Download } from '@lucide/astro';

const DISCORD_URL = minecraftGilde.discord.url;
const MINECRAFT_VERSION = minecraftGilde.minecraftVersion;
const SERVER_IP = minecraftGilde.serverIp;
const SERVER_EDITION = minecraftGilde.server.edition;
---

<HomeSection id="start" size="normal" divider>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" data-motion="reveal">
    <div>
      <h2 class="text-3xl font-semibold tracking-tight">So startest du in 3 Schritten</h2>
      <p class="text-muted mt-3 max-w-2xl">
        Alles Wichtige auf einen Blick, damit du direkt loslegen kannst.
      </p>
    </div>
  </div>

  <ol class="mt-10 grid list-none gap-8 pl-0 lg:grid-cols-3" role="list">
    <li class="relative" data-motion="reveal">
      <div class="flex h-full items-start gap-4">
        <div class="bg-accent inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl font-semibold text-black">
          1
        </div>
        <div class="flex h-full flex-col">
          <h3 class="text-base font-semibold">Jetzt spielen & joinen</h3>
          <p class="text-muted mt-2 text-sm">
            Öffne Minecraft {SERVER_EDITION}, füge <strong>{SERVER_IP}</strong> als Server hinzu und
            verbinde dich mit Minecraft-Version <strong>{MINECRAFT_VERSION}</strong>.
          </p>
          <div class="mt-5 lg:mt-auto lg:pt-3">
            <Button variant="primary" size="sm" class="gap-2" data-copy-ip>
              <Download size={16} /> Jetzt Spielen
            </Button>
          </div>
        </div>
      </div>
    </li>

    <li class="relative" data-motion="reveal" data-motion-delay="80">
      <div class="flex h-full items-start gap-4">
        <div class="bg-accent inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl font-semibold text-black">
          2
        </div>
        <div class="flex h-full flex-col">
          <h3 class="text-base font-semibold">Platz finden & claimen</h3>
          <p class="text-muted mt-2 text-sm">
            Nutze <code>/rtp</code>, finde deinen Spot und sichere dein Gebiet mit Claims.
          </p>
          <div class="mt-5 lg:mt-auto lg:pt-3">
            <Button href="/tutorial" size="sm" variant="secondary" class="gap-2">
              Tutorial <ArrowRight size={16} />
            </Button>
          </div>
        </div>
      </div>
    </li>

    <li class="relative" data-motion="reveal" data-motion-delay="160">
      <div class="flex h-full items-start gap-4">
        <div class="bg-accent inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl font-semibold text-black">
          3
        </div>
        <div class="flex h-full flex-col">
          <h3 class="text-base font-semibold">Homes setzen & dranbleiben</h3>
          <p class="text-muted mt-2 text-sm">
            Mit 25 Homes bleibst du flexibel - und auf Discord bekommst du News, Hilfe und Events.
          </p>
          <div class="mt-5 lg:mt-auto lg:pt-3">
            <Button href={DISCORD_URL} external size="sm" variant="secondary" class="gap-2">
              Discord <ArrowRight size={16} />
            </Button>
          </div>
        </div>
      </div>
    </li>
  </ol>
</HomeSection>
