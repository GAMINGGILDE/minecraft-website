---
import Button from '../../ui/Button.astro';
import HomeSection from '../HomeSection.astro';
import { minecraftGilde } from '../../../config/minecraftGilde';
import { ArrowRight, Download } from '@lucide/astro';

const DISCORD_URL = minecraftGilde.discord.url;
const SERVER_IP = minecraftGilde.serverIp;
const MINECRAFT_VERSION = minecraftGilde.minecraftVersion;
const SERVER_EDITION = minecraftGilde.server.edition;
---

<HomeSection id="join" size="normal">
  <div class="grid items-start gap-10 lg:grid-cols-[1.2fr_0.8fr]">
    <div data-motion="reveal">
      <h2 class="text-3xl font-semibold tracking-tight">Bereit für dein nächstes Projekt?</h2>
      <p class="text-muted mt-4 max-w-2xl">
        Wenn du Lust auf ein langfristiges Survival-Projekt hast, verbinde dich über{' '}
        <strong>{SERVER_IP}</strong> und such dir deinen Platz auf unserer dauerhaften Hauptwelt –
        ohne Weltreset und ohne Pay2Win.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <Button variant="primary" class="gap-2" data-copy-ip>
          <Download size={18} /> Jetzt Spielen
        </Button>
        <Button href={DISCORD_URL} external variant="secondary" class="gap-2">
          Discord <ArrowRight size={18} />
        </Button>
      </div>
    </div>

    <div class="lg:pl-10" data-motion="reveal" data-motion-delay="100">
      <div class="text-muted text-xs font-medium">Kurzinfo</div>
      <dl class="mt-4 grid gap-3 text-sm">
        <div class="flex items-center justify-between">
          <dt class="text-muted">Edition</dt>
          <dd class="font-semibold">{SERVER_EDITION}</dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-muted">Minecraft-Version</dt>
          <dd class="font-semibold">{MINECRAFT_VERSION}</dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-muted">IP</dt>
          <dd class="font-semibold">{SERVER_IP}</dd>
        </div>
      </dl>
    </div>
  </div>
</HomeSection>
