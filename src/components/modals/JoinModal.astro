---
import { Check, Copy, Download, Info, X } from '@lucide/astro';
import { minecraftGilde } from '../../config/minecraftGilde';
import Button from '../ui/Button.astro';
import IconButton from '../ui/IconButton.astro';

const SERVER_IP = minecraftGilde.serverIp;
const MINECRAFT_VERSION = minecraftGilde.minecraftVersion;
const SERVER_EDITION = minecraftGilde.server.edition;
const SERVER_PORT = minecraftGilde.server.port;
---

<div
  id="join-modal"
  class="fixed inset-0 z-[70] hidden overflow-hidden p-2 sm:p-4"
  data-join-modal
  aria-hidden="true"
>
  <div class="mg-glass-overlay absolute inset-0" data-join-modal-overlay></div>

  <div class="relative mx-auto flex h-full w-full items-center justify-center">
    <section
      class="mg-modal-panel max-h-[calc(100dvh-1rem)] max-w-4xl sm:max-h-[calc(100dvh-2rem)]"
      role="dialog"
      aria-modal="true"
      aria-labelledby="join-modal-title"
      data-join-modal-dialog
      tabindex="-1"
    >
      <header class="mg-modal-header">
        <h2 id="join-modal-title" class="mg-modal-title flex items-center gap-3">
          <Download size={22} class="text-accent" /> Jetzt auf Minecraft Gilde spielen
        </h2>

        <IconButton
          ariaLabel="Schließen"
          variant="plain"
          class="mg-modal-close"
          data-join-modal-close
        >
          <X size={20} />
        </IconButton>
      </header>

      <div class="mg-modal-body space-y-4">
        <article class="mg-card mg-card--soft p-4 sm:p-5">
          <h3 class="text-base font-semibold sm:text-xl">
            Schritt 1: Minecraft {SERVER_EDITION} installieren
          </h3>
          <p class="text-muted mt-3 text-sm leading-relaxed sm:text-base">
            Starte den Minecraft Launcher und wähle die {SERVER_EDITION}. Für unseren Server
            brauchst du keine Bedrock-Version.
          </p>
        </article>

        <article class="mg-card mg-card--soft p-4 sm:p-5">
          <h3 class="text-base font-semibold sm:text-xl">
            Schritt 2: Mit unserem Java-Server verbinden
          </h3>

          <div class="mg-card mg-card--soft mt-3 p-3 sm:p-4">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex min-w-0 flex-col gap-2">
                <div class="text-muted text-xs font-semibold tracking-wide uppercase">
                  Server-IP
                </div>
                <div class="flex flex-wrap items-center gap-2 sm:gap-3">
                  <code class="mg-text-accent-strong border-0 bg-transparent p-0 text-base font-semibold break-all sm:text-2xl">
                    {SERVER_IP}
                  </code>
                  <button
                    type="button"
                    class="mg-copy-ip-btn mg-copy-ip-btn--modal"
                    aria-label="Server-IP kopieren"
                    data-copy-ip-modal
                  >
                    <span class="relative inline-flex items-center justify-center">
                      <span
                        class="inline-flex items-center gap-2 transition-opacity duration-150"
                        data-copy-ip-modal-state-default
                      >
                        <Copy size={16} />
                        <span>IP kopieren</span>
                      </span>
                      <span
                        class="pointer-events-none absolute inset-0 inline-flex items-center justify-center gap-2 opacity-0 transition-opacity duration-150"
                        data-copy-ip-modal-state-success
                        aria-hidden="true"
                      >
                        <Check size={16} />
                        <span>IP kopiert</span>
                      </span>
                    </span>
                  </button>
                </div>
              </div>

              <div class="text-sm">
                <p class="text-muted">
                  Edition: <span class="text-fg font-semibold">{SERVER_EDITION}</span>
                </p>
                <p class="text-muted">
                  Minecraft-Version: <span class="text-fg font-semibold">{MINECRAFT_VERSION}</span>
                </p>
                <p class="text-muted">
                  Port: <span class="text-fg font-semibold">{SERVER_PORT}</span>
                </p>
                <div class="border-border/70 bg-surface mt-2 flex items-start gap-2 rounded-lg border p-2">
                  <Info size={14} class="text-accent mt-0.5 shrink-0" />
                  <p class="text-muted text-xs">
                    Meist reicht die Server-Adresse aus. Port{' '}
                    <span class="text-fg font-medium">{SERVER_PORT}</span> nur angeben, wenn dein
                    Client es ausdrücklich verlangt.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </article>

        <article class="mg-card mg-card--soft p-4 sm:p-5">
          <div class="flex items-center gap-3">
            <span
              class="mg-status-dot h-3 w-3 rounded-full"
              data-live-indicator="mc-online"
              data-status-state="loading"
            ></span>
            <h3 class="text-base font-semibold sm:text-xl">Serverstatus</h3>
          </div>
          <p class="text-muted mt-3 text-sm sm:text-base">
            Aktuell online:{' '}
            <span class="text-fg font-semibold" data-mc-online>
              0
            </span>{' '}
            Spieler
          </p>
          <p class="text-muted mt-2 text-xs sm:text-sm" data-live-note-for="mc-online">
            Lade Live-Daten ...
          </p>
        </article>
      </div>

      <footer class="mg-modal-footer text-right">
        <Button type="button" variant="primary" data-join-modal-close>
          {' '}
          Verstanden{' '}
        </Button>
      </footer>
    </section>
  </div>
</div>
