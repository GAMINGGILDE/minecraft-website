---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import DividerList from '../components/ui/DividerList.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import { TEAM_GROUPS, TEAM_MEMBERS } from '../data/team';
import { buildMcHeadsAvatarUrl, buildCraftheadHelmUrl } from '../lib/minecraft/playerTextures';
import { Shield, Wrench, ArrowRight } from '@lucide/astro';
import { minecraftGilde } from '../config/minecraftGilde';

const DISCORD_URL = minecraftGilde.discord.url;

const groups = TEAM_GROUPS.map((g) => ({
  ...g,
  members: TEAM_MEMBERS.filter((m) => m.group === g.key),
})).filter((g) => g.members.length > 0);

const groupIconByKey = {
  admin: Wrench,
  moderator: Shield,
  streamer: Shield,
} as const;
---

<BaseLayout
  title="Minecraft Gilde - Unser Team"
  description="Lerne das Team der Minecraft Gilde kennen - Admins und Moderatoren, die dir bei Fragen und Problemen weiterhelfen."
>
  <PageHeader
    title="Team"
    subtitle="Hier siehst du, wer sich um Server, Community und Support kümmert."
  >
    <Fragment slot="actions">
      <Button href={DISCORD_URL} external variant="primary" class="gap-2">
        Discord <ArrowRight size={18} />
      </Button>
      <Button href="/tutorial" variant="secondary">Tutorial</Button>
      <Button href="/regeln" variant="ghost">Regeln</Button>
    </Fragment>
  </PageHeader>

  <section class="mg-container pb-16">
    <div class="grid gap-4" data-motion-stagger="90">
      {
        groups.map((g) => {
          const GroupIcon = groupIconByKey[g.key];

          return (
            <section class="mg-card mg-card--soft p-6" data-motion="reveal">
              <div class="flex items-center justify-between gap-4">
                <div class="inline-flex items-center gap-2">
                  <GroupIcon size={18} />
                  <h2 class="text-xl font-semibold tracking-tight">{g.label}</h2>
                </div>
                <Badge variant="accent">{g.members.length}</Badge>
              </div>

              <DividerList as="ul" class="mt-4">
                {g.members.map((m) => (
                  <li class="mg-row flex items-center gap-3 py-3">
                    <div class="flex min-w-0 items-center gap-3">
                      <img
                        src={buildCraftheadHelmUrl(m.uuid, null, 96)}
                        data-avatar-fallback={buildMcHeadsAvatarUrl(m.uuid, null, 96)}
                        alt={m.inGameName}
                        width="48"
                        height="48"
                        loading="lazy"
                        decoding="async"
                        class="border-border bg-surface h-12 w-12 rounded-full border"
                      />
                      <div class="min-w-0">
                        <div class="truncate text-sm font-semibold">{m.inGameName}</div>
                      </div>
                    </div>
                    <Badge variant="neutral" class="shrink-0">
                      {m.role}
                    </Badge>
                  </li>
                ))}
              </DividerList>
            </section>
          );
        })
      }
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLImageElement>('img[data-avatar-fallback]').forEach((img) => {
      img.addEventListener('error', () => {
        const fallbackSrc = img.dataset.avatarFallback || '';
        const fallbackAttempted = img.dataset.fallbackAttempted === '1';

        if (!fallbackAttempted && fallbackSrc && img.src !== fallbackSrc) {
          img.dataset.fallbackAttempted = '1';
          img.src = fallbackSrc;
        }
      });
    });
  </script>
</BaseLayout>
