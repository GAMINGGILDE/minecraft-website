---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import DividerList from '../components/ui/DividerList.astro';
import CommandsInlineScripts from '../components/commands/CommandsInlineScripts.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import { getEntry } from 'astro:content';
import { Search, SquareTerminal, Download, X } from '@lucide/astro';

const commandsEntry = await getEntry('commands', 'list');
if (!commandsEntry) throw new Error('Missing commands content: src/content/commands/list.json');

const categories = commandsEntry.data.categories;
---

<BaseLayout
  title="Minecraft Gilde - Serverbefehle"
  description="Die wichtigsten Befehle der Minecraft Gilde für Homes, Teleports, Claims, Farmwelten, Voting und weitere Serverfunktionen – mit kurzer Erklärung."
>
  <PageHeader
    title="Befehle"
    subtitle="Hier findest du die wichtigsten Befehle der Minecraft Gilde mit kurzer Erklärung. Über die Suche kannst du direkt nach /rtp, /home oder /trust suchen."
  >
    <Fragment slot="actions">
      <Button variant="primary" class="gap-2" data-copy-ip>
        <Download size={18} /> Jetzt Spielen
      </Button>
      <Button href="/regeln" variant="secondary">
        Regeln
      </Button>
      <Button href="/tutorial" variant="ghost">
        Tutorial
      </Button>
    </Fragment>
  </PageHeader>

  <section class="mg-container pb-16" data-commands>
    <div
      class="mg-app-field mg-app-field--muted-focus mg-app-search-field lg:max-w-xl"
      data-motion="reveal"
    >
      <Search size={18} class="text-muted" />
      <input
        id="commandSearch"
        type="search"
        placeholder="Suchen (z. B. /rtp, claim, home …)"
        class="peer placeholder:text-muted/70 text-fg min-w-0 flex-1 bg-transparent text-sm outline-none"
        autocomplete="off"
      />
      <button
        type="button"
        class="mg-search-clear mg-search-clear--hidden"
        data-command-search-clear
        aria-label="Suche zurücksetzen"
        title="Suche zurücksetzen"
      >
        <X size={14} />
      </button>
    </div>

    <div class="mt-4 space-y-3" data-motion-stagger="60">
      {categories.map((cat) => (
        <details class="mg-accordion mg-filter-transition" open data-category data-motion="reveal">
          <summary class="flex items-center justify-between gap-3">
            <div class="inline-flex items-center gap-2">
              <SquareTerminal size={18} />
              <span class="text-sm font-semibold">{cat.name}</span>
            </div>
            <span class="text-muted text-xs">{cat.commands.length} Befehle</span>
          </summary>

          <DividerList as="div" class="mt-3">
            {cat.commands.map((cmd) => (
              <div
                class="mg-list-item mg-filter-transition"
                data-command
                data-search={`${cmd.command} ${cmd.description}`}
              >
                <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
                  <code class="text-fg font-mono text-sm">{cmd.command}</code>
                  <p class="text-muted text-sm">{cmd.description}</p>
                </div>
              </div>
            ))}
          </DividerList>
        </details>
      ))}
    </div>
  </section>

  <CommandsInlineScripts slot="afterScripts" />
</BaseLayout>
