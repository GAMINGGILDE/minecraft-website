---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import StatsApp from '../features/stats/StatsApp';
import { canonicalFor } from '../config/site';

const statsCanonicalUrl = canonicalFor('/statistiken/');
---

<BaseLayout
  title="Minecraft Gilde - Statistiken"
  canonical={statsCanonicalUrl}
  description="Live-Spielerstatistiken für Minecraft Gilde - Ranglisten, Server-König und Spielerübersicht."
>
  <!-- Performance: Avatar-CDN früh auflösen -->
  <link slot="head" rel="preconnect" href="https://crafthead.net" crossorigin />
  <link slot="head" rel="dns-prefetch" href="//crafthead.net" />

  <PageHeader
    title="Statistiken"
    subtitle="Suche nach Spielern, entdecke Ranglisten und sieh, wer aktuell die meisten Punkte sammelt. Die Daten werden serverseitig erzeugt, morgens und abends aktualisiert und können daher leicht verzögert sein."
    subtitleClass="text-muted mt-2 max-w-3xl"
  />

  <!-- React-Island: lädt die interaktive Statistik-App -->
  <StatsApp client:load />
</BaseLayout>
