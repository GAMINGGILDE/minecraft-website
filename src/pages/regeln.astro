---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import DividerList from '../components/ui/DividerList.astro';
import Button from '../components/ui/Button.astro';
import Callout from '../components/ui/Callout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import { getEntry } from 'astro:content';
import { Shield, Download, ArrowRight } from '@lucide/astro';

const rules = await getEntry('rules', 'main');
if (!rules) throw new Error('Rules entry "main" not found');

const { warning, minecraft } = rules.data;
---

<BaseLayout
  title="Minecraft Gilde - Serverregeln"
  description="Serverregeln der Minecraft Gilde zu Griefing, Farmwelten, Mods, AFK-Farmen, Redstone, Handel, Exploits und Community-Verhalten."
>
  <PageHeader
    title="Regeln"
    subtitle="Damit alle entspannt miteinander spielen können, findest du hier die wichtigsten Regeln für Server, Builds, Farmen und Community."
  >
    <Callout variant="warning" title="Wichtiger Hinweis" class="mt-6" slot="beforeActions">
      <p>{warning}</p>
    </Callout>

    <Fragment slot="actions">
      <Button variant="primary" class="gap-2" data-copy-ip>
        <Download size={18} /> Jetzt Spielen
      </Button>
      <Button href="/tutorial" variant="secondary" class="gap-2">
        <ArrowRight size={18} /> Tutorial
      </Button>
      <Button href="/faq" variant="ghost" class="gap-2">
        <ArrowRight size={18} /> FAQ
      </Button>
    </Fragment>
  </PageHeader>

  <section class="mg-container pb-16">
    <div class="grid gap-4" data-motion-stagger="80">
      <Card class="p-6 sm:p-7" reveal>
        <div class="flex items-center gap-4 sm:gap-5">
          <div class="border-border/70 bg-accent/10 text-accent flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border sm:h-14 sm:w-14">
            <Shield class="h-7 w-7" />
          </div>
          <h2 class="text-xl leading-tight font-semibold tracking-tight sm:text-2xl">
            {minecraft.title}
          </h2>
        </div>

        <div class="sm:ml-[4.75rem]">
          <DividerList as="ol" class="mt-5 list-decimal !pl-7 sm:!pl-8">
            {minecraft.items.map((it) => (
              <li class="mg-list-item">
                <div class="text-sm font-semibold">{it.title}</div>
                <div class="mg-prose text-muted mt-2 text-sm leading-relaxed" set:html={it.html} />
              </li>
            ))}
          </DividerList>
        </div>
      </Card>
    </div>
  </section>
</BaseLayout>
