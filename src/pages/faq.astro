---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import DividerList from '../components/ui/DividerList.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { buildFaqPage } from '../lib/structuredData';
import { ArrowRight, BookOpen, Hammer, Shield, Cpu, Users, ScrollText } from '@lucide/astro';
import { getEntry } from 'astro:content';
import { renderMarkdown } from '../utils/renderMarkdown';
import { canonicalFor, site } from '../config/site';
import { minecraftGilde } from '../config/minecraftGilde';

type FaqItem = { q: string; a: string };

type FaqGroupJson = {
  title: string;
  icon: 'BookOpen' | 'Hammer' | 'Shield' | 'Cpu';
  items: FaqItem[];
};
const ICONS = { BookOpen, Hammer, Shield, Cpu } as const;

const faqEntry = await getEntry('faq', 'main');
if (!faqEntry) {
  throw new Error('FAQ-Content (src/content/faq/main.json) konnte nicht geladen werden.');
}

const groups = (faqEntry.data as FaqGroupJson[]).map((g) => ({
  ...g,
  icon: ICONS[g.icon],
}));

const canonicalUrl = canonicalFor(Astro.url.pathname);
const faqLd = buildFaqPage({
  site,
  canonicalUrl,
  items: groups.flatMap((g) => g.items),
});
const DISCORD_URL = minecraftGilde.discord.url;
---

<BaseLayout
  title="Minecraft Gilde - FAQ zu Server, Spielweise & Technik"
  canonical={canonicalUrl}
  description="Antworten zur Minecraft Gilde: Java Edition, Pay2Win, Weltresets, Farmwelten, Claims, Mods, PvP und Technik – kurz und verständlich erklärt."
>
  <JsonLd slot="head" data={faqLd} />
  <PageHeader
    title="FAQ"
    subtitle="Die häufigsten Fragen kurz und verständlich beantwortet. Wenn dir etwas fehlt, schreib uns gern auf Discord."
    class="pb-8"
    subtitleClass="text-muted mt-2 max-w-3xl"
    actionsClass="mt-6 flex flex-wrap gap-2"
  >
    <Fragment slot="actions">
      <Button href="/tutorial" variant="secondary" size="sm" class="gap-2">
        <BookOpen size={16} /> Tutorial
      </Button>
      <Button href="/regeln" variant="ghost" size="sm" class="gap-2">
        <Shield size={16} /> Regeln
      </Button>
      <Button href="/voten" variant="ghost" size="sm" class="gap-2">
        <ArrowRight size={16} /> Voten
      </Button>
    </Fragment>
  </PageHeader>

  <section class="mg-container pb-16">
    <div class="mg-card mg-card--soft divide-border/70 divide-y" data-motion-stagger="70">
      {groups.map((g) => (
        <section class="p-6" data-motion="reveal">
          <div class="flex items-start gap-4">
            <div class="border-border/70 bg-accent/10 text-accent mt-0.5 flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border">
              <g.icon class="h-7 w-7" />
            </div>

            <div class="min-w-0 flex-1">
              <h2 class="text-lg font-semibold tracking-tight">{g.title}</h2>

              <DividerList as="div" class="mt-4">
                {g.items.map((it) => (
                  <details class="mg-list-item px-1 sm:px-2" data-motion-accordion>
                    <summary class="focus-visible:ring-offset-bg hover:bg-surface/45 focus-visible:bg-surface/45 cursor-pointer list-none rounded-[calc(var(--radius)-6px)] px-2 py-1.5 text-sm font-semibold transition-colors outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ring)] focus-visible:ring-offset-2">
                      <span class="inline-flex items-center gap-2">
                        <span
                          class="bg-accent mt-0.5 h-2 w-2 flex-none rounded-full"
                          aria-hidden="true"
                        />
                        {it.q}
                      </span>
                    </summary>
                    <div
                      class="faq-answer mg-prose mt-2 px-2 text-sm leading-relaxed"
                      set:html={renderMarkdown(it.a)}
                    />
                  </details>
                ))}
              </DividerList>
            </div>
          </div>
        </section>
      ))}
    </div>

    <div class="mt-8" data-motion="reveal" data-motion-delay="120">
      <div class="mg-card mg-card--soft p-6">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="min-w-0">
            <h2 class="text-lg font-semibold tracking-tight">Noch Fragen?</h2>
            <p class="text-muted mt-2 text-sm">
              Auf Discord bekommst du Hilfe, Updates und direkten Kontakt zur Community.
            </p>
          </div>
          <div class="flex gap-2">
            <Button href="/serverinfos" variant="secondary" size="sm" class="gap-2">
              <ScrollText size={16} /> Serverinfos
            </Button>
            <Button href={DISCORD_URL} external variant="primary" size="sm" class="gap-2">
              <Users size={16} /> Discord <ArrowRight size={16} />
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style is:global>
    /*
      FAQ nutzt die gleichen "mg-prose" Link-Styles wie der Rest der Seite.
      Hier halten wir nur den Abstand im Accordion kompakt.
    */
    .faq-answer.mg-prose > :first-child {
      margin-top: 0;
    }

    .faq-answer.mg-prose > :last-child {
      margin-bottom: 0;
    }
  </style>
</BaseLayout>
