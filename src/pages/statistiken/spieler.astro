---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlayerStatsApp from '../../features/player-stats/PlayerStatsApp';
import { canonicalFor } from '../../config/site';

const statsCanonicalUrl = canonicalFor('/statistiken/');
---

<BaseLayout
  title="Minecraft Gilde - Spielerstatistik"
  canonical={statsCanonicalUrl}
  noindex={true}
  description="Spielerstatistiken für Minecraft Gilde – Werte, Items und Kreaturen nach Spieler."
>
  <link slot="head" rel="preconnect" href="https://crafthead.net" crossorigin />
  <link slot="head" rel="dns-prefetch" href="//crafthead.net" />
  <link slot="head" rel="preconnect" href="https://mc-heads.net" crossorigin />
  <link slot="head" rel="dns-prefetch" href="//mc-heads.net" />
  <link slot="head" rel="preconnect" href="https://api.minetools.eu" crossorigin />
  <link slot="head" rel="preconnect" href="https://textures.minecraft.net" crossorigin />

  <div
    id="player-stats-placeholder"
    aria-hidden="true"
    class="space-y-6 transition-opacity duration-200"
  >
    <section class="mg-surface-1">
      <div class="mx-auto w-full max-w-[118rem] px-4 py-8 sm:px-6 xl:px-8">
        <div class="bg-surface-solid/70 h-10 w-full max-w-2xl rounded-lg"></div>
      </div>
    </section>

    <section class="mx-auto w-full max-w-[118rem] px-4 py-8 sm:px-6 xl:px-8">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-start">
        <div class="mg-surface-2 min-h-[6rem] lg:col-span-12"></div>
        <div class="mg-surface-2 min-h-[26rem] lg:col-span-12"></div>
      </div>
    </section>
  </div>

  <PlayerStatsApp client:load />
</BaseLayout>
