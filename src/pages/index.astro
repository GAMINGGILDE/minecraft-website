---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/home/HomePage.astro';

import { HOME_ANCHORS } from '../lib/home/anchors';
import { getHomeGallery } from '../lib/home/gallery';
import { minecraftGilde } from '../config/minecraftGilde';

// Home-spezifische Styles (scoped über [data-home])
import '../styles/home.css';

// Build-Time: Galerie-URLs einsammeln (wird im Build aufgerufen).
const galleryImages = await getHomeGallery();
// Version/IP zentral aus der Konfiguration holen, damit Metadaten konsistent bleiben.
const MINECRAFT_VERSION = minecraftGilde.minecraftVersion;
const SERVER_IP = minecraftGilde.serverIp;
---

<BaseLayout
  title="Minecraft Gilde - Deutscher Minecraft-Java-Server für Vanilla-SMP"
  description={`Die Minecraft Gilde ist ein deutschsprachiger Minecraft-Java-Server für Vanilla-SMP, Survival und Freebuild – mit dauerhafter Langzeitwelt ohne Reset und ohne Pay2Win. IP: ${SERVER_IP}`}
  keywords={`Minecraft Gilde, Minecraft Java Edition, Vanilla-SMP, Survival, Freebuild, Langzeitwelt, kein Pay2Win, Minecraft ${MINECRAFT_VERSION}, ${SERVER_IP}`}
  bodyClass="is-home"
>
  <HomePage anchorItems={HOME_ANCHORS} galleryImages={galleryImages} />
</BaseLayout>
