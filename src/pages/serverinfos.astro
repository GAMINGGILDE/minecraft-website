---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import DividerList from '../components/ui/DividerList.astro';
import Section from '../components/ui/Section.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import { Image } from 'astro:assets';
import { buildArticle, buildGameServer } from '../lib/structuredData';
import { Cpu, Shield, Gamepad2, Download, Map, ArrowRight } from '@lucide/astro';
import { canonicalFor, site } from '../config/site';
import { minecraftGilde } from '../config/minecraftGilde';
import foliaImage from '../assets/images/tech/folia.webp';

const DISCORD_URL = minecraftGilde.discord.url;
const DYNMAP_URL = minecraftGilde.mapUrl;
const SERVER_IP = minecraftGilde.serverIp;
const MINECRAFT_VERSION = minecraftGilde.minecraftVersion;
const SERVER = minecraftGilde.server;
const FOLIA_IMAGE_WIDTH = 704;
const FOLIA_IMAGE_HEIGHT = Math.round((foliaImage.height / foliaImage.width) * FOLIA_IMAGE_WIDTH);

const canonicalUrl = canonicalFor(Astro.url.pathname);
const pageTitle = 'Minecraft Gilde - Serverinfos, Spielweise & Technik';
const pageDescription = `Minecraft Gilde: Java Edition ${MINECRAFT_VERSION} mit Vanilla-SMP, Survival & Freebuild auf Folia – Langzeitwelt ohne Hauptwelt-Reset, Claims als Grundstücksschutz und kein Pay2Win.`;
const gameServerLd = buildGameServer({
  site,
  canonicalUrl,
});

const articleLd = buildArticle({
  site,
  canonicalUrl,
  type: 'TechArticle',
  headline: pageTitle,
  description: pageDescription,
  image: new URL(minecraftGilde.brand.logo.path, site).toString(),
  authorName: minecraftGilde.legal.name,
  authorUrl: 'https://www.falkner.info',
  articleSection: 'Serverinformationen',
});
---

<BaseLayout title={pageTitle} canonical={canonicalUrl} description={pageDescription}>
  <JsonLd slot="head" data={gameServerLd} />
  <JsonLd slot="head" data={articleLd} />
  <PageHeader
    title="Serverinfos"
    subtitle="Hier findest du alle wichtigen Details zu unserer Spielweise und Technik – von Java Edition und Folia bis zu Langzeitwelt, Claims, Farmwelten und Hardware."
    actionsInline
    headerClass="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
    actionsClass="flex flex-wrap gap-2"
  >
    <Fragment slot="actions">
      <Button variant="primary" class="gap-2" data-copy-ip>
        <Download size={18} /> Jetzt Spielen
      </Button>
      <Button href={DISCORD_URL} external variant="secondary" class="gap-2">
        Discord <ArrowRight size={18} />
      </Button>
      <Button href={DYNMAP_URL} external variant="ghost" class="gap-2">
        <Map size={18} /> Live-Karte
      </Button>
    </Fragment>

    <div class="mt-6 flex flex-wrap gap-2">
      <Badge variant="accent">{SERVER.edition}</Badge>
      <Badge>{SERVER.software}</Badge>
      <Badge>Hauptwelt ohne Reset</Badge>
      <Badge>Kein Pay2Win</Badge>
    </div>
  </PageHeader>

  <section class="mg-container pb-16">
    <p class="text-muted mb-6 max-w-3xl text-sm leading-relaxed" data-motion="reveal">
      Die Minecraft Gilde ist ein deutschsprachiger Minecraft-Java-Server für Vanilla-SMP, Survival
      und Freebuild. Auf unserer dauerhaften Hauptwelt kannst du langfristig bauen, während separate
      Farmwelten der Rohstoffbeschaffung dienen. Wir verzichten auf Pay2Win und setzen technisch auf
      Folia. Der Server ist ausschließlich für die Java Edition ausgelegt; eine Bedrock-Anbindung
      bieten wir nicht an.
    </p>

    <div class="mg-card mg-card--soft p-6 sm:p-7" data-motion="reveal">
      <div class="grid gap-8 lg:grid-cols-3">
        <section>
          <div class="flex items-start gap-3">
            <Gamepad2 size={20} />
            <h2 class="text-base font-semibold">Server auf einen Blick</h2>
          </div>
          <dl class="mg-list mt-3 text-sm">
            <div class="mg-row items-center">
              <dt class="text-muted">Server-IP</dt>
              <dd class="font-semibold">{SERVER_IP}</dd>
            </div>
            <div class="mg-row items-center">
              <dt class="text-muted">Edition</dt>
              <dd>{SERVER.edition}</dd>
            </div>
            <div class="mg-row items-center">
              <dt class="text-muted">Minecraft-Version</dt>
              <dd>{MINECRAFT_VERSION}</dd>
            </div>
            <div class="mg-row items-center">
              <dt class="text-muted">Server-Software</dt>
              <dd>{SERVER.software}</dd>
            </div>
            <div class="mg-row items-center">
              <dt class="text-muted">Spielweise</dt>
              <dd>{SERVER.gameMode}</dd>
            </div>
            <div class="mg-row items-center">
              <dt class="text-muted">Hauptwelt</dt>
              <dd>dauerhaft, seit {SERVER.mainWorldSince}</dd>
            </div>
            <div class="mg-row items-center">
              <dt class="text-muted">Whitelist</dt>
              <dd>{SERVER.whitelist ? 'Ja' : 'Nein'}</dd>
            </div>
            <div class="mg-row items-center">
              <dt class="text-muted">Pay2Win</dt>
              <dd>{SERVER.payToWin ? 'Ja' : 'Nein'}</dd>
            </div>
          </dl>
        </section>

        <section>
          <div class="flex items-start gap-3">
            <Cpu size={20} />
            <h2 class="text-base font-semibold">Technisches Setup</h2>
          </div>
          <DividerList as="ul" class="mt-3 list-none pl-0 text-sm">
            <li class="mg-row">
              <span class="text-fg/90 font-medium">CPU:</span>
              <span class="text-right">2x Intel Xeon E5-2680 v2 (20 Kerne / 40 Threads)</span>
            </li>
            <li class="mg-row">
              <span class="text-fg/90 font-medium">Arbeitsspeicher:</span>
              <span class="text-right">128 GB DDR3 ECC</span>
            </li>
            <li class="mg-row">
              <span class="text-fg/90 font-medium">Speicher:</span>
              <span class="text-right">480 GB SSD</span>
            </li>
            <li class="mg-row">
              <span class="text-fg/90 font-medium">Betriebssystem:</span>
              <span class="text-right">Ubuntu 24.04</span>
            </li>
            <li class="mg-row">
              <span class="text-fg/90 font-medium">Datenbank:</span>
              <span class="text-right">MariaDB (unter anderem für Statistiken)</span>
            </li>
            <li class="mg-row">
              <span class="text-fg/90 font-medium">Garbage Collector:</span>
              <span class="text-right">G1GC</span>
            </li>
          </DividerList>
        </section>

        <section>
          <div class="flex items-start gap-3">
            <Shield size={20} />
            <h2 class="text-base font-semibold">Gameplay &amp; Grundstücksschutz</h2>
          </div>
          <DividerList as="ul" class="text-muted mt-3 list-none pl-0 text-sm">
            <li class="mg-row !block">
              <span class="text-fg/90 font-medium">Sichtweite:</span> Die serverseitige Sichtweite
              beträgt 20 Chunks.
            </li>
            <li class="mg-row !block">
              <span class="text-fg/90 font-medium">Spawnraten:</span> Wir halten die Spawnraten
              möglichst vanilla-nah.
            </li>
            <li class="mg-row !block">
              <span class="text-fg/90 font-medium">Mobs, Villager &amp; Farmen:</span> Auch große
              Survival-Farmen sind grundsätzlich erlaubt, solange sie keine merklichen Server-Lags
              verursachen. Für Mobs, Villager und normale Survival-Farmen gibt es keine pauschalen
              künstlichen Limits.
            </li>
            <li class="mg-row !block">
              <span class="text-fg/90 font-medium">Grundstücksschutz:</span> Mit Claims über
              GriefPrevention schützt du deine Baugebiete vor unerlaubten Änderungen.
            </li>
            <li class="mg-row !block">
              <span class="text-fg/90 font-medium">Pay2Win:</span> Die Minecraft Gilde ist kein
              Pay2Win-Server. Es gibt keine kaufbaren Ränge, Items oder Gameplay-Vorteile.
            </li>
          </DividerList>
          <div class="mt-4 flex flex-wrap gap-2">
            <Button href="/tutorial" variant="secondary">
              Tutorial
            </Button>
            <Button href="/regeln" variant="ghost">
              Regeln
            </Button>
          </div>
        </section>
      </div>

      <section class="border-border/60 mt-6 border-t pt-6">
        <h2 class="text-xl font-semibold tracking-tight">Spielweise &amp; Welten</h2>
        <div class="text-muted mt-3 grid gap-3 text-sm leading-relaxed lg:grid-cols-3">
          <p>
            Der Fokus liegt auf Survival und Freebuild. Minigames oder Citybuild sind nicht das
            Spielkonzept der Minecraft Gilde.
          </p>
          <p>
            Die heutige Hauptwelt besteht seit {SERVER.mainWorldSince} und ist für langfristige
            Bauprojekte gedacht. Sie wird nicht regelmäßig zurückgesetzt.
          </p>
          <p>
            Separate Farmwelten dienen der Rohstoffbeschaffung.{' '}
            {SERVER.resourceWorldResets
              ? 'Anders als die Hauptwelt werden sie zurückgesetzt; Informationen dazu teilen wir rechtzeitig.'
              : 'Auch diese Welten bleiben bestehen und werden nicht regelmäßig zurückgesetzt.'}
          </p>
        </div>
      </section>
    </div>

    <Section
      tone="muted"
      container={false}
      padded={false}
      class="mt-6 rounded-[var(--radius)] p-6 sm:p-7"
    >
      <div class="grid gap-8 lg:grid-cols-[1.08fr_0.92fr] lg:items-start" data-motion-stagger="90">
        <article data-motion="reveal">
          <h2 class="text-xl font-semibold tracking-tight">Warum wir Folia einsetzen</h2>
          <p class="text-muted mt-3 text-sm leading-relaxed">
            Seit Mai 2025 läuft die Minecraft Gilde auf Folia. Folia basiert auf Paper und verteilt
            die Verarbeitung der Welt auf voneinander unabhängige Regionen, die parallel bearbeitet
            werden können. Für unsere weitläufige Survival-Welt ist dieser Ansatz interessant, weil
            Aktivitäten in unterschiedlichen Regionen voneinander getrennt verarbeitet werden
            können.
          </p>
          <p class="text-muted mt-3 text-sm leading-relaxed">
            Folia stellt besondere Anforderungen an Plugins, weil nicht jede Aufgabe wie auf einem
            klassischen Paper-Server über einen einzigen Hauptthread läuft. Deshalb achten wir bei
            eingesetzten Plugins gezielt auf Folia-Kompatibilität. Für dich ändert sich dadurch beim
            normalen Spielen kaum etwas – wichtig ist die Technik vor allem im Hintergrund.
          </p>
        </article>

        <figure class="lg:border-border/55 lg:border-l lg:pl-7" data-motion="reveal">
          <Image
            src={foliaImage}
            alt="Folia Logo"
            width={FOLIA_IMAGE_WIDTH}
            height={FOLIA_IMAGE_HEIGHT}
            loading="lazy"
            class="mx-auto w-full max-w-[18rem] sm:max-w-[20rem] md:max-w-[22rem]"
          />
          <figcaption class="text-muted mt-4 text-center text-sm">
            Folia basiert auf Paper und verarbeitet voneinander unabhängige Weltregionen parallel.
          </figcaption>
        </figure>
      </div>

      <div class="border-border/60 mt-6 border-t pt-6" data-motion="reveal">
        <p class="text-sm leading-relaxed">
          Wie Claims funktionieren, erklären wir dir Schritt für Schritt im Tutorial. Dort findest
          du auch RTP, Rollen und alles Wichtige für deinen Start.
        </p>
        <div class="mt-3">
          <Button href="/tutorial" variant="primary">
            Zum Tutorial
          </Button>
        </div>
      </div>
    </Section>
  </section>
</BaseLayout>
