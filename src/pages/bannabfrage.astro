---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import { canonicalFor } from '../config/site';
import { Search, TimerReset, X } from '@lucide/astro';

const canonicalUrl = canonicalFor('/bannabfrage/');
---

<BaseLayout
  title="Minecraft Gilde - Bannabfrage"
  canonical={canonicalUrl}
  description="Prüfe, ob ein Spieler auf der Minecraft Gilde bekannt ist und ob ein aktiver Bann vorliegt."
>
  <PageHeader
    title="Bannabfrage"
    subtitle="Prüfe mit einem exakten Spielernamen oder einer UUID, ob für einen Spieler aktuell ein Bann aktiv ist."
  >
    <div class="mt-6 flex flex-wrap gap-2">
      <Badge variant="accent">Live-Abfrage</Badge>
      <Badge>Name oder UUID</Badge>
      <Badge>Aktive Bans</Badge>
    </div>
  </PageHeader>

  <section class="mg-container pb-16" data-ban-query-app>
    <div class="grid min-w-0 gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]">
      <article class="mg-card mg-card--soft min-w-0 p-4 sm:p-7" data-motion="reveal">
        <form class="space-y-3" data-ban-form>
          <label for="ban-query-input" class="text-sm font-medium">
            Spielername oder UUID
          </label>
          <div class="flex min-w-0 flex-col items-stretch gap-2 sm:flex-row">
            <div class="mg-app-field mg-app-field--muted-focus mg-app-search-field min-w-0 sm:flex-1">
              <Search size={18} class="text-muted" />
              <input
                id="ban-query-input"
                name="query"
                data-ban-input
                class="peer placeholder:text-muted/70 text-fg min-w-0 flex-1 bg-transparent text-sm outline-none"
                type="search"
                placeholder="Spieler suchen..."
                minlength="2"
                maxlength="64"
                autocomplete="off"
                required
              />
              <button
                type="button"
                class="mg-search-clear mg-search-clear--hidden"
                data-ban-search-clear
                aria-label="Suche zurücksetzen"
                title="Suche zurücksetzen"
              >
                <X size={14} />
              </button>
            </div>
            <Button
              type="submit"
              variant="primary"
              class="w-full self-stretch sm:w-auto sm:min-w-[8.5rem]"
              data-ban-submit-button
            >
              Prüfen
            </Button>
          </div>
          <p class="text-muted text-xs">
            Die Abfrage prüft den Spielerbestand und aktive Bans anhand von Name oder UUID.
          </p>
        </form>

        <p
          class="text-muted mt-4 min-h-6 min-w-0 text-sm break-words"
          role="status"
          aria-live="polite"
          data-ban-feedback
        >
          Suche nach einem Spieler, um den Bannstatus zu sehen.
        </p>

        <div class="mt-4 space-y-4" data-ban-result>
          <article class="mg-notice" data-variant="neutral" data-ban-view="idle">
            <div class="mg-notice__content">
              Gib oben einen Spielernamen oder eine UUID ein und starte die Abfrage.
            </div>
          </article>

          <article class="mg-notice" data-variant="neutral" data-ban-view="loading" hidden>
            <div class="mg-notice__content">Abfrage läuft. Bitte kurz warten...</div>
          </article>

          <article class="mg-notice" data-variant="neutral" data-ban-view="unknown" hidden>
            <div class="mg-notice__content">
              Der Spieler{' '}
              <strong class="break-all" data-ban-query-value>
                Unbekannt
              </strong>{' '}
              hat unseren Server noch nie besucht.
            </div>
          </article>

          <article class="mg-notice" data-variant="neutral" data-ban-view="not-banned" hidden>
            <div class="mg-notice__content">
              <p class="font-semibold">Der Spieler ist nicht gebannt.</p>
              <dl class="mg-list mt-3 text-sm">
                <div class="mg-row flex-col gap-1 sm:flex-row sm:items-center">
                  <dt class="text-muted shrink-0">Spieler</dt>
                  <dd class="m-0 max-w-full min-w-0 break-words sm:text-right" data-ban-player-name>
                    -
                  </dd>
                </div>
                <div class="mg-row flex-col gap-1 sm:flex-row sm:items-center">
                  <dt class="text-muted shrink-0">UUID</dt>
                  <dd
                    class="m-0 max-w-full min-w-0 font-mono text-xs break-all sm:text-right"
                    data-ban-player-uuid
                  >
                    -
                  </dd>
                </div>
                <div class="mg-row flex-col gap-1 sm:flex-row sm:items-center">
                  <dt class="text-muted shrink-0">Quelle</dt>
                  <dd
                    class="m-0 max-w-full min-w-0 break-words sm:text-right"
                    data-ban-player-source
                  >
                    -
                  </dd>
                </div>
                <div class="mg-row flex-col gap-1 sm:flex-row sm:items-center">
                  <dt class="text-muted shrink-0">Erst gesehen</dt>
                  <dd
                    class="m-0 max-w-full min-w-0 break-words sm:text-right"
                    data-ban-player-first-seen
                  >
                    -
                  </dd>
                </div>
                <div class="mg-row flex-col gap-1 sm:flex-row sm:items-center">
                  <dt class="text-muted shrink-0">Zuletzt gesehen</dt>
                  <dd
                    class="m-0 max-w-full min-w-0 break-words sm:text-right"
                    data-ban-player-last-seen
                  >
                    -
                  </dd>
                </div>
              </dl>
            </div>
          </article>

          <div class="space-y-4" data-ban-view="banned" hidden>
            <article class="mg-notice" data-ban-name-change-notice hidden>
              <div class="mg-notice__content space-y-3">
                <div>
                  <p class="font-semibold" data-ban-status-headline>
                    Aktiver Bann gefunden.
                  </p>
                  <p class="text-muted mt-1" data-ban-status-description>
                    Der Bannstatus wurde eindeutig zugeordnet.
                  </p>
                </div>
                <dl class="grid min-w-0 gap-3 text-sm sm:grid-cols-2">
                  <div class="min-w-0" data-ban-status-current-row>
                    <dt class="text-muted text-xs font-medium">Aktueller Name</dt>
                    <dd
                      class="text-fg m-0 mt-1 min-w-0 font-semibold break-words"
                      data-ban-status-current-name
                    >
                      -
                    </dd>
                  </div>
                  <div class="min-w-0" data-ban-status-name-at-ban-row>
                    <dt class="text-muted text-xs font-medium">Gebannt als</dt>
                    <dd
                      class="text-fg m-0 mt-1 min-w-0 font-semibold break-words"
                      data-ban-status-name-at-ban
                    >
                      -
                    </dd>
                  </div>
                </dl>
              </div>
            </article>

            <article class="mg-notice" data-variant="warning">
              <div class="mg-notice__content">
                <p class="font-semibold">Ban-Details</p>
                <dl class="mg-list mt-3 text-sm">
                  <div class="mg-row flex-col gap-1 sm:flex-row sm:items-center">
                    <dt class="text-muted shrink-0">Spieler</dt>
                    <dd
                      class="m-0 max-w-full min-w-0 break-words sm:text-right"
                      data-ban-banned-player-name
                    >
                      -
                    </dd>
                  </div>
                  <div class="mg-row flex-col gap-1 sm:flex-row sm:items-center">
                    <dt class="text-muted shrink-0">UUID</dt>
                    <dd
                      class="m-0 max-w-full min-w-0 font-mono text-xs break-all sm:text-right"
                      data-ban-player-uuid
                    >
                      -
                    </dd>
                  </div>
                  <div class="mg-row flex-col gap-1 sm:flex-row sm:items-center">
                    <dt class="text-muted shrink-0">Grund</dt>
                    <dd class="m-0 max-w-full min-w-0 break-words sm:text-right" data-ban-reason>
                      -
                    </dd>
                  </div>
                  <div class="mg-row flex-col gap-1 sm:flex-row sm:items-center">
                    <dt class="text-muted shrink-0">Gebannt von</dt>
                    <dd class="m-0 max-w-full min-w-0 break-words sm:text-right" data-ban-by>
                      -
                    </dd>
                  </div>
                  <div class="mg-row flex-col gap-1 sm:flex-row sm:items-center">
                    <dt class="text-muted shrink-0">Gebannt am</dt>
                    <dd class="m-0 max-w-full min-w-0 break-words sm:text-right" data-ban-at>
                      -
                    </dd>
                  </div>
                  <div class="mg-row flex-col gap-1 sm:flex-row sm:items-center">
                    <dt class="text-muted shrink-0">Läuft ab</dt>
                    <dd
                      class="m-0 max-w-full min-w-0 break-words sm:text-right"
                      data-ban-expires-at
                    >
                      -
                    </dd>
                  </div>
                  <div class="mg-row flex-col gap-1 sm:flex-row sm:items-center">
                    <dt class="text-muted shrink-0">Permanent</dt>
                    <dd
                      class="m-0 max-w-full min-w-0 break-words sm:text-right"
                      data-ban-is-permanent
                    >
                      -
                    </dd>
                  </div>
                </dl>
              </div>
            </article>
          </div>

          <article class="mg-error-message" data-ban-view="error" hidden>
            <span class="mg-error-message__icon" data-ban-rate-limit-icon hidden aria-hidden="true">
              <TimerReset size={14} />
            </span>
            <div class="min-w-0 break-words" data-ban-error-message>
              Die Bannabfrage ist aktuell nicht verfügbar.
            </div>
          </article>
        </div>
      </article>

      <aside
        class="mg-card mg-card--soft min-w-0 p-4 sm:p-7"
        data-motion="reveal"
        data-motion-delay="90"
      >
        <h2 class="text-xl font-semibold tracking-tight">So liest du das Ergebnis</h2>
        <ul class="text-muted mt-4 space-y-3 text-sm leading-relaxed">
          <li>
            <strong class="text-fg">Noch nie besucht:</strong> Es wurde kein Eintrag im bekannten
            Spielerbestand gefunden.
          </li>
          <li>
            <strong class="text-fg">Nicht gebannt:</strong> Der Spieler ist bekannt, aber es liegt
            kein aktiver Bann vor.
          </li>
          <li>
            <strong class="text-fg">Gebannt:</strong> Ein aktiver Bann wurde gefunden und die
            Banninformationen werden angezeigt.
          </li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>
