---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import Callout from '../components/ui/Callout.astro';
import Section from '../components/ui/Section.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { buildArticle } from '../lib/structuredData';
import { ArrowRight, Flag, Globe, Rocket, Cpu, Paintbrush } from '@lucide/astro';
import { Image } from 'astro:assets';
import { canonicalFor, site } from '../config/site';
import { minecraftGilde } from '../config/minecraftGilde';
import type { ImageMetadata } from 'astro';

const DISCORD_URL = minecraftGilde.discord.url;

const canonicalUrl = canonicalFor(Astro.url.pathname);

const articleLd = buildArticle({
  site,
  canonicalUrl,
  type: 'Article',
  headline: 'Unsere Geschichte - Minecraft Gilde',
  description:
    'Von minecraft.falkner.info bis zum Folia-Vanilla-Server: die wichtigsten Meilensteine der Minecraft Gilde seit Februar 2024.',
  image: new URL(minecraftGilde.brand.logo.path, site).toString(),
  authorName: minecraftGilde.legal.name,
  authorUrl: 'https://www.falkner.info',
  articleSection: 'Geschichte',
});

type Milestone = {
  id: string;
  date: string;
  title: string;
  paragraphs: string[];
  image?: {
    src: ImageMetadata;
    alt: string;
    decorative?: boolean;
    sizes?: string;
    widths?: number[];
  };
  cta?: boolean;
};

// Tipp: Wenn du Bilder integrieren willst, lege sie z. B. unter
// /src/assets/images/history/ ab, importiere sie lokal und setze pro Milestone optional `image`.
const milestones: Milestone[] = [
  {
    id: 'feb-2024',
    date: 'Februar 2024',
    title: 'Die Stunde null',
    paragraphs: [
      'Im Februar 2024 ging unter dem Namen minecraft.falkner.info ein kleiner Server mit sieben Slots online. Frische Welt, pures Vanilla-Feeling - und schnell fanden sich die ersten Stammspieler:innen zusammen.',
      'Mit jedem neuen Projekt und jeder größeren Basis stiegen auch die Anforderungen. Noch 2024 folgte deshalb ein Hardware-Upgrade, damit der Server stabil bleibt und weiter wachsen kann.',
    ],
  },
  {
    id: 'herbst-2024',
    date: 'Herbst 2024',
    title: 'Der Wunsch nach einem klaren Auftritt',
    paragraphs: [
      'Als immer mehr Spieler dazukamen, wurde klar: Der Server brauchte auch nach außen einen klareren Auftritt. Der alte Name war praktisch, aber sperrig - und ohne eigene Webseite fehlte ein zentraler Ort für Regeln, Infos und Updates.',
    ],
  },
  {
    id: 'winter-2024',
    date: 'Herbst/Winter 2024',
    title: '„Minecraft Gilde“ entsteht',
    paragraphs: [
      'In vielen Gesprächen und langen Discord-Abenden - gemeinsam mit unserem Partner, dem Anti-Corona-Kartell - suchten wir nach einem Namen, der hängen bleibt. Am Ende setzte sich „Minecraft Gilde“ durch: kurz, einprägsam und passend zu dem, was wir aufbauen wollten.',
      'Parallel entstanden Domain und Logo. Aus einer Idee wurde Schritt für Schritt eine Webseite, die den Server bis heute begleitet.',
    ],
  },
  {
    id: 'jan-2025',
    date: '01. Januar 2025',
    title: 'Die Minecraft Gilde geht online',
    paragraphs: [
      'Am 1. Januar 2025 war es so weit: Unter dem neuen Namen, mit Logo und eigener Domain ging die Minecraft Gilde offiziell online. Damit gab es endlich einen festen Anlaufpunkt für alles rund um den Server.',
    ],
  },
  {
    id: 'fruehjahr-2025',
    date: 'Frühjahr 2025',
    title: 'Leistungsgrenzen und Ursachenforschung',
    paragraphs: [
      'Mit größeren Basen und mehr gleichzeitigen Spieler:innen zeigten sich die Grenzen der bisherigen Technik deutlich. Wir optimierten viel und testeten verschiedene Ansätze - langfristig brauchte es aber eine stärkere Lösung.',
    ],
  },
  {
    id: 'maerz-2025',
    date: 'März 2025',
    title: 'Erste Tests mit Folia',
    paragraphs: [
      'Bei der Suche nach einer Lösung stießen wir auf Folia, eine Server-Software mit regionsbasiertem Multithreading. Im März 2025 starteten die ersten Tests - und die Ergebnisse fühlten sich wie ein echter Schritt nach vorn an.',
    ],
  },
  {
    id: 'mai-2025',
    date: '01. Mai 2025',
    title: 'Der Wechsel auf Folia',
    paragraphs: [
      'Am 1. Mai 2025 stellten wir final um: Seitdem läuft die Minecraft Gilde auf Folia. Das Ziel blieb gleich - ein dauerhaftes Vanilla-Erlebnis ohne Reset, aber mit mehr Reserven für alles, was die Community baut.',
    ],
  },
  {
    id: 'juli-2026',
    date: '01. Juli 2026',
    title: 'Unter dem Dach der Gaming Gilde',
    paragraphs: [
      'Zum 1. Juli 2026 wachsen das Anti-Corona-Kartell und die Minecraft Gilde organisatorisch in der Gaming Gilde zusammen. Die Minecraft Gilde bleibt als Servermarke bestehen: mit eigener Welt, bekanntem Vanilla-SMP-Fokus und gemeinsamer Community unter dem Dach der Gaming Gilde.',
    ],
  },
  {
    id: 'weiter',
    date: 'Ausblick',
    title: 'Und wie geht es weiter?',
    paragraphs: [
      'Das war erst der Anfang. Wenn du die nächsten Kapitel miterleben willst, komm gern auf unseren Discord - dort teilen wir Updates, Events und neue Ideen zuerst.',
    ],
    cta: true,
  },
];
---

<BaseLayout
  title="Minecraft Gilde - Geschichte - Von den Anfängen bis Folia"
  canonical={canonicalUrl}
  description="Erfahre die Geschichte der Minecraft Gilde - vom kleinen Privatserver bis zum etablierten Vanilla-Freebuild-Server auf Folia-Basis."
>
  <JsonLd slot="head" data={articleLd} />

  <PageHeader
    title="Geschichte"
    subtitleClass="text-muted mt-2"
    actionsInline
    headerClass="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
    actionsClass="flex flex-wrap gap-2"
  >
    <Fragment slot="subtitle">
      Von <span class="text-fg font-medium">minecraft.falkner.info</span> bis Folia - unsere Reise
      seit Februar 2024.
    </Fragment>

    <Fragment slot="actions">
      <Button href={DISCORD_URL} external variant="secondary" class="gap-2">
        Discord <ArrowRight size={18} />
      </Button>
      <Button href="/serverinfos" variant="ghost">
        Serverinfos
      </Button>
    </Fragment>

    <div class="mt-6 flex flex-wrap gap-2">
      <Badge variant="accent">Start: Feb 2024</Badge>
      <Badge>Website: 01.01.2025</Badge>
      <Badge>Folia: seit 01.05.2025</Badge>
      <Badge>Ohne Reset seit 2024</Badge>
    </div>
  </PageHeader>

  <section class="mg-container pb-16">
    <div class="grid gap-4 lg:grid-cols-3">
      <div class="grid gap-4 lg:col-span-2">
        <Callout variant="tip" title="Kurz erklärt" data-motion="reveal">
          Hier findest du die wichtigsten Stationen unserer Entwicklung - kompakt und
          nachvollziehbar erzählt.
        </Callout>

        <Section
          tone="muted"
          container={false}
          padded={false}
          class="rounded-[var(--radius)] p-6 sm:p-6 lg:p-7"
        >
          <h2 class="text-base font-semibold tracking-tight">Meilensteine</h2>

          <div class="relative mt-6">
            <div
              class="bg-border/70 absolute top-2 bottom-2 left-4 w-px [mask-image:linear-gradient(to_bottom,transparent,black_10%,black_90%,transparent)]"
              aria-hidden="true"
            ></div>

            <ol class="list-none pl-0" data-motion-stagger="70">
              {milestones.map((m, index) => (
                <li id={m.id} class="relative py-6 pl-12 last:pb-0" data-motion="reveal">
                  <div class="absolute top-8 left-4 -translate-x-1/2">
                    <div class="border-border/60 bg-accent/10 ring-accent/25 flex h-10 w-10 items-center justify-center rounded-full border ring-1 backdrop-blur-md">
                      <div class="bg-accent h-2.5 w-2.5 rounded-full shadow-[0_0_0_8px_rgba(242,201,76,0.10)]" />
                    </div>
                  </div>

                  <article class="pt-3">
                    <div class="flex flex-wrap items-center gap-2">
                      <Badge variant={m.cta ? 'neutral' : 'accent'}>{m.date}</Badge>
                    </div>

                    <h3 class="mt-3 text-lg font-semibold tracking-tight">{m.title}</h3>

                    {m.paragraphs.map((p) => (
                      <p class="text-muted mt-2 text-sm leading-relaxed">{p}</p>
                    ))}

                    {m.image ? (
                      <Image
                        src={m.image.src}
                        alt={m.image.decorative ? '' : m.image.alt}
                        aria-hidden={m.image.decorative ? 'true' : undefined}
                        loading="lazy"
                        decoding="async"
                        sizes={m.image.sizes ?? '(min-width: 1024px) 42rem, 100vw'}
                        widths={m.image.widths ?? [640, 960, 1280]}
                        class="border-border/60 mt-4 aspect-[16/9] w-full rounded-[calc(var(--radius)-6px)] border object-cover"
                      />
                    ) : null}

                    {m.cta ? (
                      <div class="mt-4">
                        <Button href={DISCORD_URL} external variant="primary" class="gap-2">
                          Auf Discord dabei sein <ArrowRight size={18} />
                        </Button>
                      </div>
                    ) : null}

                    {index < milestones.length - 1 ? (
                      <div
                        class="border-border/55 mt-6 h-px [mask-image:linear-gradient(to_right,black_84%,transparent)]"
                        aria-hidden="true"
                      />
                    ) : null}
                  </article>
                </li>
              ))}
            </ol>
          </div>
        </Section>
      </div>

      <div class="grid gap-4">
        <section class="mg-card mg-card--soft p-5 sm:p-5" data-motion="reveal">
          <h2 class="text-base font-semibold tracking-tight">Was uns geprägt hat</h2>
          <ul class="text-muted mt-4 space-y-3 text-sm">
            <li class="flex gap-3">
              <Flag size={18} class="shrink-0" />
              <span>Eine freundliche Atmosphäre und ein starkes Miteinander als Basis.</span>
            </li>
            <li class="flex gap-3">
              <Globe size={18} class="shrink-0" />
              <span>Stetiges Wachstum und technische Weiterentwicklung im Hintergrund.</span>
            </li>
            <li class="flex gap-3">
              <Paintbrush size={18} class="shrink-0" />
              <span>Ein klarer Auftritt mit neuem Namen, Logo, Domain und Webseite.</span>
            </li>
            <li class="flex gap-3">
              <Cpu size={18} class="shrink-0" />
              <span>Der Anspruch, Performance-Probleme wirklich zu lösen statt zu verwalten.</span>
            </li>
            <li class="flex gap-3">
              <Rocket size={18} class="shrink-0" />
              <span>Der mutige Schritt zu Folia für mehr Stabilität bei viel Betrieb.</span>
            </li>
          </ul>
        </section>

        <section class="mg-card mg-card--soft p-5 sm:p-5" data-motion="reveal">
          <h2 class="text-base font-semibold tracking-tight">Noch mehr Details?</h2>
          <p class="text-muted mt-3 text-sm leading-relaxed">
            Wenn dich das Setup interessiert oder du wissen willst, wie wir Folia betreiben, findest
            du die wichtigsten Infos auf der Serverinfos-Seite.
          </p>
          <div class="mt-4">
            <Button href="/serverinfos" variant="secondary" class="gap-2">
              Serverinfos öffnen <ArrowRight size={18} />
            </Button>
          </div>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
